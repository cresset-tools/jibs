// Preview database for a Magento shop: the most recent orders with everything
// they reference, a slice of the catalog, and no personal data.
//
// Two rules keep the subset the size that was asked for, and both are about
// tables jibs would otherwise import in full:
//
//  1. A table that holds personal data and is NOT reached by an aggregate is
//     imported whole. Every such table is named below: reached through a
//     relation or its own aggregate, or imported empty with exclude_data.
//  2. Backward relations are followed from an aggregate's root, so a catalog
//     aggregate drags in every order item (and from there every order and
//     customer) that mentions its products. The products aggregate excludes
//     the sales side.
var order_limit: int = 100
var order_days: int = 90
var product_limit: int = 500

faker names ["Alex", "Sam", "Robin", "Kim", "Noa", "Jesse"]
faker emails ["user{unique()}@example.test"]
faker phones ["+31600000001", "+31600000002", "+31600000003"]
faker streets ["Example Street 1", "Example Street 2", "Example Street 3"]

// --- Relations the schema does not declare ---------------------------------
// Forward only in effect: an order item brings its product along.
relation sales_order_item.product_id -> catalog_product_entity.entity_id
// The flat grid tables carry copies of names and addresses and have no
// foreign keys, so without these they would be imported whole.
relation sales_order_grid.entity_id -> sales_order.entity_id
relation sales_invoice_grid.order_id -> sales_order.entity_id
relation sales_shipment_grid.order_id -> sales_order.entity_id
relation sales_creditmemo_grid.order_id -> sales_order.entity_id

// --- Personal data: replaced on the source before it is sent ----------------
anonymize customer_entity {
    email -> emails
    firstname -> names
    middlename -> null
    lastname -> names
    dob -> null
    taxvat -> null
    password_hash -> null
    rp_token -> null
}
anonymize customer_address_entity {
    firstname -> names
    middlename -> null
    lastname -> names
    company -> null
    street -> streets
    telephone -> phones
    fax -> null
    vat_id -> null
}
anonymize sales_order {
    customer_email -> emails
    customer_firstname -> names
    customer_middlename -> null
    customer_lastname -> names
    customer_dob -> null
    customer_taxvat -> null
    remote_ip -> null
    x_forwarded_for -> null
}
anonymize sales_order_address {
    email -> emails
    firstname -> names
    middlename -> null
    lastname -> names
    company -> null
    street -> streets
    telephone -> phones
    fax -> null
    vat_id -> null
}
anonymize sales_order_payment {
    additional_information -> null
    cc_owner -> null
    cc_last_4 -> null
    cc_number_enc -> null
    cc_trans_id -> null
    echeck_account_name -> null
}
anonymize sales_order_grid {
    customer_email -> emails
    customer_name -> names
    shipping_name -> names
    billing_name -> names
    billing_address -> streets
    shipping_address -> streets
    payment_additional_information -> null
}
anonymize sales_invoice_grid {
    customer_email -> emails
    customer_name -> names
    billing_name -> names
    billing_address -> streets
    shipping_address -> streets
}
anonymize sales_shipment_grid {
    customer_email -> emails
    customer_name -> names
    billing_name -> names
    shipping_name -> names
    billing_address -> streets
    shipping_address -> streets
}
anonymize sales_creditmemo_grid {
    customer_email -> emails
    customer_name -> names
    billing_name -> names
    billing_address -> streets
    shipping_address -> streets
}
anonymize admin_user {
    email -> emails
    firstname -> names
    lastname -> names
    password -> null
    rp_token -> null
}
// Encrypted config values ("<key version>:<cipher>:<payload>") become NULL
anonymize core_config_data where "value REGEXP '^[0-9]+:[0-9]+:'" {
    value -> null
}

// --- Customer data a preview does not need: structure only -------------------
exclude_data /^quote/
exclude_data /^wishlist/
exclude_data customer_grid_flat
exclude_data customer_visitor
exclude_data newsletter_subscriber
exclude_data review_detail
exclude_data persistent_session
exclude_data session
exclude_data admin_user_session
exclude_data admin_passwords
exclude_data oauth_token
exclude_data oauth_nonce
exclude_data password_reset_request_event
exclude_data /^login_as_customer/
// Changelogs, logs and reports
exclude_data /_cl$/
exclude_data /_log$/
exclude_data /^report_/

// --- What comes across -------------------------------------------------------
aggregate orders {
    root sales_order
    where "created_at > DATE_SUB(NOW(), INTERVAL {$order_days} DAY)"
    order by created_at desc
    limit $order_limit
}

// The address book of the customers those orders belong to. Customers are
// reached forward from their orders, and backward relations are not followed
// from there, so their addresses need a root of their own.
aggregate addresses {
    root customer_address_entity
    where "parent_id IN (SELECT customer_id FROM (SELECT customer_id FROM sales_order WHERE created_at > DATE_SUB(NOW(), INTERVAL {$order_days} DAY) ORDER BY created_at DESC LIMIT {$order_limit}) recent)"
}

aggregate products {
    root catalog_product_entity
    where "entity_id <= {$product_limit}"
    exclude /^sales_/, /^quote/, /^wishlist/, /^report_/
}
